name: Generate Sitemap

on:
  push:
    branches:
      - main  # 💡 如果你的預設分支是 master，請改成 master

jobs:
  sitemap:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Generate Sitemap
        id: sitemap
        uses: cicirello/generate-sitemap@v1
        with:
          # ⚠️ 這裡非常重要！必須填入你綁定好的自訂網域，結尾要加斜線
          base-url-path: https://csbica.org 
          
          # 💡 選填優化：自動移除網址結尾的 .html（讓網域看起來更乾淨）
          drop-extension: true 

      - name: Commit and Push Sitemap
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@://github.com"
          git add sitemap.xml
          git commit -m "Automated sitemap generation for custom domain" || exit 0
          git push
